{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "cn.local.batteryflowranker",
  "applicationName": "真实流水排名助手",
  "author": "killuahcr-sys",
  "description": "离线截图识别、上船扣除与真实流水排名工具",
  "version": "1.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "serverHeaders": {
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "require-corp",
    "Cross-Origin-Resource-Policy": "same-origin"
  },
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "os.showOpenDialog",
    "os.showSaveDialog",
    "filesystem.readBinaryFile",
    "filesystem.writeBinaryFile",
    "clipboard.writeText"
  ],
  "modes": {
    "window": {
      "title": "真实流水排名助手",
      "width": 1420,
      "height": 900,
      "minWidth": 1080,
      "minHeight": 680,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "useLogicalPixels": true,
      "newWindowPolicy": "browser",
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "rankingtools",
    "resourcesPath": "/light/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/light/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "distributionPath": "/dist-light"
  }
}
